# This only prints. `roch-nvram setup` lets one user start Roch NVRAM's root helper without a password,
# so whoever installs this runs it themselves, and removing the package leaves what they did in place.

post_install() {
  cat <<'END'
Roch NVRAM asks for your password through pkexec to read the BIOS setup database and to write settings. To stop that, once:
  sudo roch-nvram setup
Installed from this package, setup names /usr/bin/roch-nvram itself, so updates keep it working.
END
}

post_upgrade() {
  # A setup made from a home install named a copy in /usr/local/bin, not this package's program.
  if [ -e /usr/local/bin/roch-nvram ]; then
    echo "Run 'sudo roch-nvram setup' once more so the password-free helper is this package's roch-nvram."
  fi
  return 0
}

post_remove() {
  local rule=/etc/polkit-1/rules.d/49-roch-nvram.rules
  if [ -e "$rule" ]; then
    echo "Still in place: $rule. It names a program that is gone, so it no longer does anything."
    echo "To remove it: sudo rm $rule"
  fi
  return 0
}
